extends Node
## Autoload: a small mixed sound system.
##
## Clips come from `assets/audio/*.wav` (generated by tools/gen_assets.py) when
## present, and are synthesised at runtime otherwise, so the game is never
## silent on a fresh clone. Each clip is wrapped in an AudioStreamRandomizer so
## repeated shots vary in pitch and level, sounds play on a dedicated SFX bus
## with a light reverb, and the music bed ducks under explosions.

const MUSIC_BUS := "Music"
const SFX_BUS := "SFX"
const MAX_VOICES := 24

var _music_player: AudioStreamPlayer
var _clips: Dictionary = {}
var _voices: Array = []
var _music_base_db := -12.0
var _duck := 0.0
## Headless builds run the dummy audio driver: playing streams there costs CPU
## and leaves playbacks referenced by the AudioServer when the engine tears down
## (the `--quit-after` ObjectDB leak warning). Buses are still built so the mix
## layout stays valid; only playback is skipped.
var _silent := false


func _ready() -> void:
	_ensure_buses()
	_silent = AudioServer.get_driver_name() == "Dummy"
	if _silent:
		return
	_load_clips()
	_music_player = AudioStreamPlayer.new()
	_music_player.bus = MUSIC_BUS
	_music_player.volume_db = _music_base_db
	add_child(_music_player)


## Releases the streams on shutdown. Without this the AudioServer still holds the
## music playbacks when Godot tears the engine down, which shows up as leaked
## AudioStreamWAV / AudioStreamPlayback objects at exit.
func _notification(what: int) -> void:
	if what == NOTIFICATION_PREDELETE or what == NOTIFICATION_WM_CLOSE_REQUEST:
		_silence()


func _silence() -> void:
	if _music_player and is_instance_valid(_music_player):
		_music_player.stop()
		_music_player.stream = null
	for v in _voices:
		if is_instance_valid(v):
			v.stop()
			v.stream = null
	_voices.clear()


func _process(delta: float) -> void:
	_smooth_intensity(delta)
	if _duck > 0.0:
		_duck = maxf(_duck - delta * 1.6, 0.0)
		_apply_music_volume()
	for v in _voices.duplicate():
		if not is_instance_valid(v) or not v.playing:
			_voices.erase(v)


func _apply_music_volume() -> void:
	if _music_player:
		_music_player.volume_db = _music_base_db - _duck * 10.0


# ------------------------------------------------------------------- buses

## Master -> Music, SFX. SFX carries a short reverb so impacts sit in a space.
func _ensure_buses() -> void:
	_ensure_bus(MUSIC_BUS, "Master", -4.0)
	var sfx := _ensure_bus(SFX_BUS, "Master", -2.0)
	if sfx >= 0 and AudioServer.get_bus_effect_count(sfx) == 0:
		var reverb := AudioEffectReverb.new()
		reverb.room_size = 0.42
		reverb.damping = 0.55
		reverb.wet = 0.14
		reverb.dry = 0.95
		AudioServer.add_bus_effect(sfx, reverb)
	var music := AudioServer.get_bus_index(MUSIC_BUS)
	if music >= 0 and AudioServer.get_bus_effect_count(music) == 0:
		var eq := AudioEffectEQ6.new()
		eq.set_band_gain_db(0, -3.0)
		eq.set_band_gain_db(1, -1.0)
		AudioServer.add_bus_effect(music, eq)


func _ensure_bus(bus_name: String, send: String, volume_db: float) -> int:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx < 0:
		AudioServer.add_bus()
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
	var send_idx := AudioServer.get_bus_index(send)
	if send_idx >= 0:
		AudioServer.set_bus_send(idx, send)
	AudioServer.set_bus_volume_db(idx, volume_db)
	return idx


# ------------------------------------------------------------------- clips

func _load_clips() -> void:
	var dir := DirAccess.open("res://assets/audio")
	if dir == null:
		return
	for file in dir.get_files():
		if file.get_extension().to_lower() == "wav":
			var stream := _load_wav("res://assets/audio/%s" % file)
			if stream:
				_clips[file.get_basename()] = _randomized(stream)


## Wraps a clip so repeated playback varies slightly in pitch and level.
func _randomized(stream: AudioStream) -> AudioStreamRandomizer:
	var r := AudioStreamRandomizer.new()
	r.random_pitch = 1.04
	r.random_volume_offset_db = 1.5
	r.add_stream(0, stream)
	return r


func _load_wav(path: String) -> AudioStream:
	if not FileAccess.file_exists(path):
		return null
	if _is_imported(path):
		return load(path) as AudioStream
	return AudioStreamWAV.load_from_file(path)


## True when the import cache entry for `path` is present on disk.
func _is_imported(path: String) -> bool:
	var import_path := path + ".import"
	if not FileAccess.file_exists(import_path):
		return false
	var file := FileAccess.open(import_path, FileAccess.READ)
	if file == null:
		return false
	while not file.eof_reached():
		var line := file.get_line()
		if line.begins_with("path="):
			var remap := line.substr(5).strip_edges().trim_prefix("\"").trim_suffix("\"")
			return FileAccess.file_exists(remap)
	return false


func _play_clip(clip_name: String, volume_db := -6.0) -> bool:
	if not _clips.has(clip_name):
		return false
	_spawn(_clips[clip_name], volume_db)
	return true


func _spawn(stream: AudioStream, volume_db: float, pitch := 1.0) -> void:
	if _silent:
		return
	if _voices.size() >= MAX_VOICES:
		var oldest = _voices.pop_front()
		if is_instance_valid(oldest):
			oldest.queue_free()
	var player := AudioStreamPlayer.new()
	player.bus = SFX_BUS
	player.stream = stream
	player.volume_db = volume_db
	player.pitch_scale = pitch
	add_child(player)
	_voices.append(player)
	player.play()
	player.finished.connect(player.queue_free)


## Briefly lowers the music so explosions and gunfire stay readable.
func duck(amount: float) -> void:
	_duck = maxf(_duck, clampf(amount, 0.0, 1.0))
	_apply_music_volume()


# ------------------------------------------------------------------ voices

## One-shot tone: `sweep` bends the pitch down (or up when negative).
func play_tone(freq: float, duration: float, volume_db := -8.0, sweep := 0.0) -> void:
	_spawn(_make_tone(freq, duration, sweep), volume_db)


## Noise burst, e.g. for impacts and explosions.
func play_noise(duration: float, volume_db := -6.0, cutoff := 0.5) -> void:
	_spawn(_make_noise(duration, cutoff), volume_db)


func gunshot() -> void:
	if _play_clip("gunshot", -5.0):
		return
	play_noise(0.12, -5.0, 0.8)
	play_tone(180.0, 0.1, -9.0, 0.6)


func hit_confirm() -> void:
	if _play_clip("hit", -9.0):
		return
	play_tone(880.0, 0.08, -11.0, 0.0)


func civilian_hit() -> void:
	if _play_clip("alarm", -6.0):
		return
	play_tone(220.0, 0.35, -7.0, 0.7)


func engine_loop_note() -> void:
	_spawn(_make_tone(90.0, 0.2, 0.1), -20.0, randf_range(0.96, 1.04))


func crash() -> void:
	duck(0.25)
	if _play_clip("crash", -4.0):
		return
	play_noise(0.35, -4.0, 0.4)


func explosion() -> void:
	duck(0.6)
	if _play_clip("explosion", -3.0):
		return
	play_noise(0.6, -3.0, 0.25)
	play_tone(70.0, 0.5, -7.0, 0.5)


## Deep rolling thunder for the storm; long tail, low end.
func thunder() -> void:
	if _play_clip("thunder", -5.0):
		return
	play_noise(1.8, -8.0, 0.06)
	play_tone(48.0, 1.6, -9.0, 0.35)


func boost_whoosh() -> void:
	if _play_clip("boost", -7.0):
		return
	play_noise(0.4, -9.0, 0.9)
	play_tone(300.0, 0.3, -13.0, -0.4)


# ------------------------------------------------------------------- music

## Adaptive music: four layers (drums, bass, arpeggio, lead) played together
## by an AudioStreamSynchronized so they stay in phase. `set_intensity()` fades
## the upper layers in as the action heats up, which the modes drive each frame.
const LOOP := 4.0
const LAYER_MIN := [0.0, 0.20, 0.45, 0.70]

var _intensity := 0.0
var _intensity_target := 0.0


## Sets how intense the music should be, 0 (calm) to 1 (full).
func set_intensity(value: float) -> void:
	_intensity_target = clampf(value, 0.0, 1.0)


func intensity() -> float:
	return _intensity


## Fades the layer volumes toward the current intensity.
func _smooth_intensity(delta: float) -> void:
	_intensity = lerpf(_intensity, _intensity_target, clampf(delta * 2.5, 0.0, 1.0))
	if _music_player == null:
		return
	var sync := _music_player.stream as AudioStreamSynchronized
	if sync == null:
		return
	for i in sync.stream_count:
		var target := 0.0 if _intensity >= LAYER_MIN[i] else -80.0
		sync.set_sync_stream_volume(i, lerpf(sync.get_sync_stream_volume(i), target, 0.25))


## Starts a looping music bed for a mode. `kind` sets the base tempo.
func start_music(kind: String) -> void:
	if _music_player == null:
		return
	if not _music_player.playing:
		_music_player.stream = _make_music()
		_music_player.play()
	_intensity = 0.0
	_intensity_target = 0.0
	match kind:
		"tps":
			_music_player.pitch_scale = 1.0
		"rail":
			_music_player.pitch_scale = 1.12
		"drive":
			_music_player.pitch_scale = 1.25


func stop_music() -> void:
	if _music_player:
		_music_player.stop()


func _make_tone(freq: float, duration: float, sweep: float) -> AudioStreamWAV:
	var rate := 22050
	var frames := int(rate * duration)
	var bytes := PackedByteArray()
	bytes.resize(frames * 4)
	var phase := 0.0
	for i in frames:
		var t := float(i) / rate
		var f := freq * (1.0 + sweep * t / maxf(duration, 0.001))
		phase += TAU * f / rate
		var env := 1.0 - t / duration
		var s := sin(phase) * env * 0.6
		bytes.encode_s16(i * 4, int(clampf(s, -1.0, 1.0) * 32767.0))
		bytes.encode_s16(i * 4 + 2, int(clampf(s, -1.0, 1.0) * 32767.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.stereo = true
	wav.data = bytes
	return wav


func _make_noise(duration: float, cutoff: float) -> AudioStreamWAV:
	var rate := 22050
	var frames := int(rate * duration)
	var bytes := PackedByteArray()
	bytes.resize(frames * 4)
	var rng := RandomNumberGenerator.new()
	rng.seed = 12345
	var prev := 0.0
	for i in frames:
		var t := float(i) / rate
		var env := pow(1.0 - t / duration, 2.0)
		var white := rng.randf_range(-1.0, 1.0)
		prev = prev + (white - prev) * cutoff
		var s := prev * env * 0.8
		bytes.encode_s16(i * 4, int(clampf(s, -1.0, 1.0) * 32767.0))
		bytes.encode_s16(i * 4 + 2, int(clampf(s, -1.0, 1.0) * 32767.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.stereo = true
	wav.data = bytes
	return wav


## Short tense loop: a low pulse, a bass line and a two-note motif.

func _make_music() -> AudioStreamSynchronized:
	var sync := AudioStreamSynchronized.new()
	sync.stream_count = 4
	sync.set_sync_stream(0, _layer_drums())
	sync.set_sync_stream(1, _layer_bass())
	sync.set_sync_stream(2, _layer_arp())
	sync.set_sync_stream(3, _layer_lead())
	for i in 4:
		sync.set_sync_stream_volume(i, 0.0 if i == 0 else -80.0)
	return sync


## Wraps a per-sample function into a looping 16-bit WAV.
func _render(sample: Callable) -> AudioStreamWAV:
	var rate := 22050
	var frames := int(rate * LOOP)
	var bytes := PackedByteArray()
	bytes.resize(frames * 4)
	for i in frames:
		var s := clampf(float(sample.call(float(i) / rate)), -1.0, 1.0)
		var v := int(s * 32767.0)
		bytes.encode_s16(i * 4, v)
		bytes.encode_s16(i * 4 + 2, v)
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.stereo = true
	wav.loop_mode = AudioStreamWAV.LOOP_FORWARD
	wav.loop_begin = 0
	wav.loop_end = frames
	wav.data = bytes
	return wav


## Kick on every beat, snare on the off beat, hats in between.
func _layer_drums() -> AudioStreamWAV:
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	return _render(func(t: float) -> float:
		var s := 0.0
		var kick := fmod(t, 1.0)
		if kick < 0.16:
			s += sin(TAU * (150.0 - 620.0 * kick) * kick) * exp(-kick * 22.0) * 0.75
		var snare := fmod(t + 0.5, 1.0)
		if snare < 0.13:
			s += rng.randf_range(-1.0, 1.0) * exp(-snare * 34.0) * 0.32
		var hat := fmod(t, 0.25)
		if hat < 0.04:
			s += rng.randf_range(-1.0, 1.0) * exp(-hat * 140.0) * 0.14
		return s)


## One root note per bar (A then F), plucked on each beat.
func _layer_bass() -> AudioStreamWAV:
	var roots := [55.0, 43.65]
	return _render(func(t: float) -> float:
		var root: float = roots[int(t / 2.0) % roots.size()]
		var env := exp(-fmod(t, 0.5) * 5.0)
		return (sin(TAU * root * t) + 0.35 * sin(TAU * root * 2.0 * t)) * env * 0.5)


## Eighth-note arpeggio over an A-minor chord.
func _layer_arp() -> AudioStreamWAV:
	var chord := [220.0, 261.63, 329.63, 392.0]
	return _render(func(t: float) -> float:
		var note: float = chord[int(t / 0.25) % chord.size()]
		var env := exp(-fmod(t, 0.25) * 14.0)
		return sin(TAU * note * t) * env * 0.18)


## A two-note motif that answers the drums on the first and third beats.
func _layer_lead() -> AudioStreamWAV:
	return _render(func(t: float) -> float:
		var freq := 440.0 if int(t) % 2 == 0 else 523.25
		var env := exp(-fmod(t, 1.0) * 3.5)
		return sin(TAU * freq * t) * env * 0.12)
